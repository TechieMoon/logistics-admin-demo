# 비워 두면 로컬 PGlite(.data/pglite)에 데모 데이터를 만들어 씁니다.
# Supabase: Project Settings → Database → Connection string → Transaction pooler(6543) 주소
DATABASE_URL=
# Supabase에 처음 배포할 때 가상 주문 36건을 넣으려면 true
SEED_DEMO=false

# 직원 로그인 비밀번호와 쿠키 서명 키(16자 이상)
ADMIN_PASSWORD=
SESSION_SECRET=

# true면 로그인·조회 화면에 데모 비밀번호와 예시 주문번호를 보여 줍니다(빌드 시점에 반영).
DEMO_MODE=false

# 상태가 바뀔 때 알림을 보낼 웹훅(Slack/Discord 등). 비우면 기록만 남깁니다.
NOTIFY_WEBHOOK_URL=
